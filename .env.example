# Copia este archivo como .env (cp .env.example .env) y llena los valores.
# .env está en .gitignore: nunca se sube al repo.

# Token que te dio @BotFather (formato 123456789:AA...)
TELEGRAM_BOT_TOKEN=

# Tu chat_id (número). Obtenlo con: npm run chat-id
TELEGRAM_CHAT_ID=

# Opcionales (sobrescriben config.json solo en esta ejecución):
# MODOS=ida,redondo        # modos a correr, ignora "activo" del config
# UMBRAL=99999             # fuerza un umbral alto en todos los modos (para probar la alerta)
# HEADLESS=0               # 0 = navegador visible
# SIN_EXTRAS=1             # solo cotiza el boleto (sin equipaje ni asientos)
